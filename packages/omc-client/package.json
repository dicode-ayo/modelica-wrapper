{
  "name": "@dicode/omc-client",
  "version": "0.0.3",
  "description": "TypeScript client for OpenModelica's interactive ZeroMQ scripting API. Typed wrappers, Zod-validated outputs, no VSCode dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api/*": "./src/api/*",
    "./eval": "./src/eval/index.ts",
    "./shapes": "./src/shapes/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./eval": {
        "types": "./dist/eval/index.d.ts",
        "import": "./dist/eval/index.js"
      },
      "./shapes": {
        "types": "./dist/shapes/index.d.ts",
        "import": "./dist/shapes/index.js"
      },
      "./api/*": {
        "types": "./dist/api/*/index.d.ts",
        "import": "./dist/api/*/index.js"
      },
      "./api/*/index.js": {
        "types": "./dist/api/*/index.d.ts",
        "import": "./dist/api/*/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "OMC_INTEGRATION=0 vitest run",
    "capture-modelinstance-fixtures": "node scripts/capture-modelinstance-fixtures.mjs",
    "check-modelinstance-schema-drift": "node scripts/check-modelinstance-schema-drift.mjs",
    "coverage:recount": "node scripts/check-coverage-counts.mjs",
    "test:coverage": "OMC_INTEGRATION=0 vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "dependencies": {
    "zeromq": "^6.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
