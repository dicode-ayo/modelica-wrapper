{
  "name": "@dicode/result-ui",
  "version": "0.0.2",
  "description": "Standalone Lit + ECharts custom elements (<om-*>) for the postprocessing / results view. Independent of the diagram editor (no Babylon).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "start": "pnpm storybook",
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "test:coverage": "vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "dependencies": {
    "@dicode/ui-common": "workspace:*",
    "echarts": "^6.1.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@storybook/web-components": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "happy-dom": "^15.11.7",
    "storybook": "^10.5.10",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
