{
  "name": "@modelica-wrapper/result-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone Lit + ECharts custom elements (<om-*>) for the postprocessing / results view. Independent of the diagram editor (no Babylon).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "pnpm storybook",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@modelica-wrapper/ui-common": "workspace:*",
    "echarts": "^5.5.0",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/web-components": "^8.4.0",
    "@storybook/web-components-vite": "^8.4.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.11.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
