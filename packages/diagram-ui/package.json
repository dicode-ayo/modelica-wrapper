{
  "name": "@modelica-wrapper/diagram-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Lit + Babylon.js custom elements (<om-*>) for the Modelica graphical layout editor. Loaded inside the VSCode extension's webview.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@babylonjs/core": "^7.39.0",
    "@babylonjs/gui": "^7.39.0",
    "@lit/context": "^1.1.4",
    "@modelica-wrapper/diagram-svg": "workspace:*",
    "@modelica-wrapper/omc-client": "workspace:*",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
