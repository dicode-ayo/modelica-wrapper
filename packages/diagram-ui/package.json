{
  "name": "@dicode/diagram-ui",
  "version": "0.0.3",
  "description": "Lit + PixiJS custom elements (<om-*>) for the Modelica graphical layout editor. Loaded inside the VSCode extension's webview.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./command-ids": "./src/commands/command-ids.ts",
    "./entity-keys": "./src/interaction/entity-keys.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "start": "storybook dev -p 6007 --no-open",
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "test:coverage": "vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@dicode/diagram-svg": "workspace:*",
    "@dicode/modelica-lang-core": "workspace:*",
    "@dicode/omc-client": "workspace:*",
    "@dicode/ui-common": "workspace:*",
    "@headless-tree/core": "^1.7.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/web-components": "^8.4.0",
    "@storybook/web-components-vite": "^8.4.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^2.1.0",
    "happy-dom": "^15.11.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0"
  }
}
