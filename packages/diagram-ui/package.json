{
  "name": "@dicode/diagram-ui",
  "version": "0.0.1",
  "description": "Lit + Babylon.js custom elements (<om-*>) for the Modelica graphical layout editor. Loaded inside the VSCode extension's webview.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "start": "storybook dev -p 6007 --no-open",
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.7.0",
    "@babylonjs/core": "^7.39.0",
    "@babylonjs/gui": "^7.39.0",
    "@babylonjs/inspector": "^7.39.0",
    "@babylonjs/serializers": "^7.39.0",
    "@lit/context": "^1.1.4",
    "@dicode/diagram-svg": "workspace:*",
    "@dicode/omc-client": "workspace:*",
    "@dicode/ui-common": "workspace:*",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/web-components": "^8.4.0",
    "@storybook/web-components-vite": "^8.4.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.11.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
