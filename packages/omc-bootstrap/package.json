{
  "name": "@dicode/omc-bootstrap",
  "version": "0.0.1",
  "description": "Locates OpenModelica for the extension. No VSCode dependency, no OMC protocol knowledge.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pin": "node scripts/check-micromamba-pin.mjs",
    "update:lockfiles": "node scripts/update-lockfiles.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
