{
  "name": "modelica-wrapper",
  "displayName": "Modelica",
  "description": "Graphical model editor and simulation runner for Modelica, backed by OpenModelica.",
  "version": "0.0.2",
  "publisher": "drojdestvensky",
  "private": true,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.mo",
    "onFileSystem:modelica-source",
    "onFileSystem:modelica-doc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "modelica",
        "aliases": [
          "Modelica",
          "modelica"
        ],
        "extensions": [
          ".mo"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "omresults",
        "aliases": [
          "Modelica Result View"
        ],
        "extensions": [
          ".omresults"
        ]
      }
    ],
    "grammars": [
      {
        "language": "modelica",
        "scopeName": "source.modelica",
        "path": "./syntaxes/modelica.tmLanguage.json"
      },
      {
        "scopeName": "modelica.documentation.html.injection",
        "path": "./syntaxes/documentation-html.injection.json",
        "injectTo": [
          "source.modelica"
        ],
        "embeddedLanguages": {
          "text.html": "html"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "modelica.resultView",
        "displayName": "Modelica Result View",
        "selector": [
          {
            "filenamePattern": "*.omresults"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "modelica.diagram",
        "displayName": "Modelica Diagram",
        "selector": [
          {
            "filenamePattern": "*.mo"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "modelica.icon",
        "displayName": "Modelica Icon",
        "selector": [
          {
            "filenamePattern": "*.mo"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "modelica.documentation",
        "displayName": "Modelica Documentation",
        "selector": [
          {
            "filenamePattern": "*.mo"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "modelica.getOmcVersion",
        "title": "Modelica: Show OMC Version"
      },
      {
        "command": "modelica.openDiagram",
        "title": "Modelica: Open Diagram"
      },
      {
        "command": "modelica.diagram.selectAll",
        "title": "Modelica: Select All in Diagram"
      },
      {
        "command": "modelica.diagram.delete",
        "title": "Modelica: Delete Diagram Selection"
      },
      {
        "command": "modelica.diagram.rotateCw",
        "title": "Modelica: Rotate Diagram Selection Clockwise"
      },
      {
        "command": "modelica.diagram.rotateCcw",
        "title": "Modelica: Rotate Diagram Selection Counterclockwise"
      },
      {
        "command": "modelica.diagram.flipHorizontal",
        "title": "Modelica: Flip Diagram Selection Horizontally"
      },
      {
        "command": "modelica.diagram.flipVertical",
        "title": "Modelica: Flip Diagram Selection Vertically"
      },
      {
        "command": "modelica.diagram.copy",
        "title": "Modelica: Copy Diagram Selection"
      },
      {
        "command": "modelica.diagram.paste",
        "title": "Modelica: Paste Into Diagram"
      },
      {
        "command": "modelica.diagram.showKeymapHelp",
        "title": "Modelica: Show Diagram Keyboard Shortcuts"
      },
      {
        "command": "modelica.diagram.bringToFront",
        "title": "Modelica: Bring Diagram Shape to Front"
      },
      {
        "command": "modelica.diagram.bringForward",
        "title": "Modelica: Bring Diagram Shape Forward"
      },
      {
        "command": "modelica.diagram.sendBackward",
        "title": "Modelica: Send Diagram Shape Backward"
      },
      {
        "command": "modelica.diagram.sendToBack",
        "title": "Modelica: Send Diagram Shape to Back"
      },
      {
        "command": "modelica.loadLibrary",
        "title": "Modelica: Load Library...",
        "icon": "$(cloud-download)"
      },
      {
        "command": "modelica.tree.refresh",
        "title": "Modelica: Refresh Libraries",
        "icon": "$(refresh)"
      },
      {
        "command": "modelica.createClass",
        "title": "Modelica: New Class...",
        "icon": "$(add)"
      },
      {
        "command": "modelica.savePackage",
        "title": "Modelica: Save Package As...",
        "icon": "$(save-as)"
      },
      {
        "command": "modelica.initializeWorkspaceAsPackage",
        "title": "Modelica: Initialize Workspace as Package..."
      },
      {
        "command": "modelica.viewSource",
        "title": "Modelica: View Source",
        "icon": "$(file-code)"
      },
      {
        "command": "modelica.openDiagramFromSource",
        "title": "Modelica: Open Diagram",
        "icon": "$(circuit-board)"
      },
      {
        "command": "modelica.openAsText",
        "title": "Modelica: Open as Text",
        "icon": "$(file-code)"
      },
      {
        "command": "modelica.openAsIcon",
        "title": "Modelica: Open as Icon",
        "icon": "$(symbol-color)"
      },
      {
        "command": "modelica.openAsDiagram",
        "title": "Modelica: Open as Diagram",
        "icon": "$(circuit-board)"
      },
      {
        "command": "modelica.openAsDocumentation",
        "title": "Modelica: Open as Documentation",
        "icon": "$(book)"
      },
      {
        "command": "modelica.showLogs",
        "title": "Modelica: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "modelica.checkModel",
        "title": "Modelica: Check Model",
        "icon": "$(checklist)"
      },
      {
        "command": "modelica.openRepl",
        "title": "Modelica: Open REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "modelica.repl.exec",
        "title": "Modelica: Execute REPL Command (programmatic)"
      },
      {
        "command": "modelica.createResultView",
        "title": "Modelica: New Result View",
        "icon": "$(graph)"
      },
      {
        "command": "modelica.addResultToView",
        "title": "Modelica: Add Result to View (programmatic)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modelica-sidebar",
          "title": "Modelica",
          "icon": "$(symbol-namespace)"
        }
      ]
    },
    "views": {
      "modelica-sidebar": [
        {
          "id": "modelica.libraries",
          "type": "webview",
          "name": "Libraries",
          "icon": "$(library)",
          "contextualTitle": "Modelica"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "modelica.loadLibrary",
          "when": "view == modelica.libraries",
          "group": "navigation@1"
        },
        {
          "command": "modelica.createClass",
          "when": "view == modelica.libraries",
          "group": "navigation@2"
        },
        {
          "command": "modelica.tree.refresh",
          "when": "view == modelica.libraries",
          "group": "navigation@3"
        },
        {
          "command": "modelica.openRepl",
          "when": "view == modelica.libraries",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "modelica.openAsText",
          "when": "resourceScheme == modelica-source",
          "group": "navigation@1"
        },
        {
          "command": "modelica.openAsIcon",
          "when": "resourceScheme == modelica-source",
          "group": "navigation@2"
        },
        {
          "command": "modelica.openAsDiagram",
          "when": "resourceScheme == modelica-source",
          "group": "navigation@3"
        },
        {
          "command": "modelica.openAsDocumentation",
          "when": "resourceScheme == modelica-source",
          "group": "navigation@4"
        },
        {
          "command": "modelica.checkModel",
          "when": "resourceScheme == modelica-source && !activeCustomEditorId",
          "group": "navigation@5"
        },
        {
          "command": "modelica.checkModel",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "modelica.openAsText",
          "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon || activeCustomEditorId == modelica.documentation) && resourceScheme == modelica-source"
        },
        {
          "command": "modelica.openAsIcon",
          "when": "resourceScheme == modelica-source"
        },
        {
          "command": "modelica.openAsDiagram",
          "when": "resourceScheme == modelica-source"
        },
        {
          "command": "modelica.openAsDocumentation",
          "when": "resourceScheme == modelica-source"
        },
        {
          "command": "modelica.diagram.delete",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.rotateCw",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.rotateCcw",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.flipHorizontal",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.flipVertical",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.copy",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.paste",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        },
        {
          "command": "modelica.diagram.showKeymapHelp",
          "when": "activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon"
        }
      ]
    },
    "keybindings": [
      {
        "command": "modelica.diagram.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.delete",
        "key": "delete",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.delete",
        "key": "backspace",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.rotateCw",
        "key": "r",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.rotateCcw",
        "key": "shift+r",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.flipHorizontal",
        "key": "f",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.flipVertical",
        "key": "shift+f",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.bringForward",
        "key": "ctrl+]",
        "mac": "cmd+]",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.sendBackward",
        "key": "ctrl+[",
        "mac": "cmd+[",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.bringToFront",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.sendToBack",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      },
      {
        "command": "modelica.diagram.showKeymapHelp",
        "key": "shift+/",
        "when": "(activeCustomEditorId == modelica.diagram || activeCustomEditorId == modelica.icon) && !modelicaDiagramInputFocus && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Modelica",
      "properties": {
        "modelica.omcPath": {
          "type": "string",
          "default": "",
          "description": "Path to the omc binary. Leave empty to use 'omc' from PATH."
        },
        "modelica.checkOnEdit": {
          "type": "boolean",
          "default": true,
          "description": "Run a debounced semantic check on each edit and surface diagnostics in the Problems panel."
        },
        "modelica.checkDebounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 250,
          "description": "Debounce window (ms) between the last edit and the auto-check pipeline. Minimum 250 ms."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/fetch-grammar-wasm.mjs",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "OMC_INTEGRATION=0 vitest run --passWithNoTests",
    "test:e2e": "cd e2e && npm test",
    "test:e2e:headed": "cd e2e && npm run test:headed",
    "test:e2e:ui": "cd e2e && npm run test:ui",
    "test:e2e:debug": "cd e2e && npm run test:debug",
    "test:e2e:omc": "cd e2e && npm run test:omc",
    "package": "node esbuild.config.mjs --production && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@dicode/diagram-svg": "workspace:*",
    "@dicode/diagram-ui": "workspace:*",
    "@dicode/documentation-ui": "workspace:*",
    "@dicode/modelica-completion": "workspace:*",
    "@dicode/modelica-lang-core": "workspace:*",
    "@dicode/omc-client": "workspace:*",
    "@dicode/result-ui": "workspace:*",
    "@dicode/ui-common": "workspace:*",
    "lit": "^3.2.0",
    "web-tree-sitter": "^0.25.10",
    "zeromq": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
