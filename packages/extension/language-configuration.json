{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:(?:partial|encapsulated|replaceable|redeclare)\\s+)*(?:model|class|connector|block|record|package|function|type|operator)\\b(?![^=;\\n]*[=;])|(?:when|while|for|if|elseif)\\b.*\\b(?:then|loop)\\s*$|(?:else|equation|algorithm|public|protected)\\b\\s*$|initial\\s+(?:equation|algorithm)\\s*$)(?!.*\\bend\\b).*$",
    "decreaseIndentPattern": "^\\s*(end\\b|else\\b|elseif\\b|elsewhen\\b|\\)|\\}|\\])"
  }
}
