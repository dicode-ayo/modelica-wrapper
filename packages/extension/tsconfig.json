{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/extension.ts",
    "src/diagram/**/*.ts",
    "src/language/**/*.ts",
    "src/results/**/*.ts",
    "src/webview/protocol.ts",
    "src/webview/postprocessing-protocol.ts",
    "src/**/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "src/webview/webview-entry.ts",
    "src/webview/postprocessing-entry.ts",
    "src/webview/**/*.test.ts"
  ]
}
