{
  "name": "modelica-wrapper-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright + code-server end-to-end smoke test for the modelica-wrapper VSCode extension.",
  "scripts": {
    "test": "playwright test --config=playwright.config.ts",
    "test:headed": "playwright test --config=playwright.config.ts --headed",
    "test:ui": "playwright test --config=playwright.config.ts --ui",
    "test:debug": "playwright test --config=playwright.config.ts --debug",
    "test:omc": "E2E_OMC=1 playwright test --config=playwright.config.ts",
    "install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
