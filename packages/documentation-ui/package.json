{
  "name": "@dicode/documentation-ui",
  "version": "0.0.1",
  "description": "Standalone Lit + TipTap custom element (<om-documentation-editor>) for editing a Modelica class's Documentation(info=…) HTML. VSCode-agnostic pure renderer, reusable in a web client.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^3",
    "@tiptap/extension-image": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-subscript": "^3",
    "@tiptap/extension-superscript": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/starter-kit": "^3",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@storybook/web-components": "^8.4.0",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
