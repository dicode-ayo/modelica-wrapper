{
  "name": "@dicode/documentation-ui",
  "version": "0.0.1",
  "description": "Standalone Lit + TipTap custom element (<om-documentation-editor>) for editing a Modelica class's Documentation(info=…) HTML. VSCode-agnostic pure renderer, reusable in a web client.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./interface-model": "./src/interface-model.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./interface-model": {
        "types": "./dist/interface-model.d.ts",
        "import": "./dist/interface-model.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "dependencies": {
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "js-beautify": "^1.15.4",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@storybook/web-components": "^8.4.0",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^2.1.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
