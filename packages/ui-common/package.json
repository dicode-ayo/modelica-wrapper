{
  "name": "@modelica-wrapper/ui-common",
  "version": "0.0.1",
  "private": true,
  "description": "Shared UI foundation for the <om-*> webviews: design tokens (--om-*) and the Web Awesome → VSCode theme bridge. No Babylon, no OMC — depended on by both diagram-ui and result-ui.",
