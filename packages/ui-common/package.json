{
  "name": "@dicode/ui-common",
  "version": "0.0.3",
  "description": "Shared UI foundation for the <om-*> webviews: design tokens (--om-*) and the Web Awesome → VSCode theme bridge. No Babylon, no OMC — depended on by both diagram-ui and result-ui.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./webawesome-setup": "./src/webawesome-setup.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./webawesome-setup": {
        "types": "./dist/webawesome-setup.d.ts",
        "import": "./dist/webawesome-setup.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.7.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.6.0"
  }
}
