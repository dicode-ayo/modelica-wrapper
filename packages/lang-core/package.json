{
  "name": "@dicode/modelica-lang-core",
  "version": "0.0.3",
  "description": "Pure Modelica cursor classification + semantic resolution. No VSCode dependency.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "OMC_INTEGRATION=0 vitest run",
    "test:coverage": "OMC_INTEGRATION=0 vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
