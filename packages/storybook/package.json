{
  "name": "@dicode/storybook",
  "version": "0.0.1",
  "private": true,
  "description": "Aggregator Storybook: combines the diagram-svg, diagram-ui, result-ui and documentation-ui stories into one build, published to a single Chromatic project.",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --stats-json"
  },
  "dependencies": {
    "@dicode/diagram-svg": "workspace:*",
    "@dicode/diagram-ui": "workspace:*",
    "@dicode/documentation-ui": "workspace:*",
    "@dicode/result-ui": "workspace:*",
    "@dicode/ui-common": "workspace:*"
  },
  "devDependencies": {
    "@storybook/html": "^10.5.10",
    "@storybook/web-components": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@types/node": "^24.13.3",
    "storybook": "^10.5.10",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
