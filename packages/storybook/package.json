{
  "name": "@modelica-wrapper/storybook",
  "version": "0.0.1",
  "private": true,
  "description": "Aggregator Storybook: combines the diagram-svg, diagram-ui and result-ui stories into one build, published to a single Chromatic project.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@modelica-wrapper/diagram-svg": "workspace:*",
    "@modelica-wrapper/diagram-ui": "workspace:*",
    "@modelica-wrapper/result-ui": "workspace:*",
    "@modelica-wrapper/ui-common": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/html": "^8.4.0",
    "@storybook/web-components": "^8.4.0",
    "@storybook/web-components-vite": "^8.4.0",
    "@types/node": "^22.0.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
