{
  "name": "@modelica-wrapper/diagram-svg",
  "version": "0.0.1",
  "description": "Renders typed IconLayer[] from @modelica-wrapper/omc-client into self-contained SVG strings.",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "OMC_INTEGRATION=0 vitest run",
    "test:watch": "vitest",
    "test:unit": "OMC_INTEGRATION=0 vitest run",
    "capture-icons": "OMC_INTEGRATION=1 vitest run test/capture-icon-fixtures.integration.test.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@modelica-wrapper/omc-client": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/html": "^8.4.0",
    "@storybook/html-vite": "^8.4.0",
    "@types/node": "^22.0.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
