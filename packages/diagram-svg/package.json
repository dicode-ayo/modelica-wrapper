{
  "name": "@dicode/diagram-svg",
  "version": "0.0.2",
  "description": "Renders typed IconLayer[] from @dicode/omc-client into self-contained SVG strings.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "OMC_INTEGRATION=0 vitest run",
    "test:watch": "vitest",
    "test:unit": "OMC_INTEGRATION=0 vitest run",
    "capture-icons": "OMC_INTEGRATION=1 vitest run test/capture-icon-fixtures.integration.test.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:coverage": "OMC_INTEGRATION=0 vitest run --coverage",
    "crap": "crap4ts --src src --exclude \".test.\" --exclude \".stories.\" --exclude \".fixture\" --coverage-command \"pnpm test:coverage\""
  },
  "dependencies": {
    "@dicode/omc-client": "workspace:*"
  },
  "devDependencies": {
    "@storybook/html": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "storybook": "^10.5.10",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
