{
  "name": "modelica-wrapper-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for the modelica-wrapper VSCode extension and the @modelica-wrapper/omc-client package.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter modelica-wrapper build",
    "watch": "pnpm --filter modelica-wrapper watch",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "zeromq"]
  }
}
