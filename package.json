{
  "name": "modelica-wrapper-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for the modelica-wrapper VSCode extension and the @dicode/omc-client package.",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "start": "pnpm --filter @dicode/diagram-ui start",
    "build": "pnpm --filter modelica-wrapper build",
    "watch": "pnpm --filter modelica-wrapper watch",
    "storybook": "pnpm --filter @dicode/storybook storybook",
    "build-storybook": "pnpm --filter @dicode/storybook build-storybook",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:coverage": "pnpm -r test:coverage",
    "crap": "pnpm -r crap",
    "test:e2e": "pnpm --filter modelica-wrapper test:e2e",
    "test:e2e:headed": "pnpm --filter modelica-wrapper test:e2e:headed",
    "test:e2e:ui": "pnpm --filter modelica-wrapper test:e2e:ui",
    "test:e2e:debug": "pnpm --filter modelica-wrapper test:e2e:debug",
    "test:e2e:omc": "pnpm --filter modelica-wrapper test:e2e:omc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sebassdc/crap4ts": "^0.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "zeromq"
    ]
  }
}
