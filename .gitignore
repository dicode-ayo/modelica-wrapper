
# Node / VSCode extension
node_modules/
out/
dist/
*.vsix
packages/extension/build/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/

# Local direnv env — holds a machine-specific CLAUDE_CONFIG_DIR path, not committed.
.envrc

# Regenerated on demand by `pnpm --filter @dicode/omc-client capture-modelinstance-fixtures`.
# These captures are large (~40k lines for PID_Controller alone) and easy to
# reproduce from any OMC install — keep them out of git.
packages/omc-client/test/fixtures/*.modelInstance.json
packages/omc-client/test/fixtures/*.modelInstanceAnnotation.json
storybook-static/

# Grammar WASM is fetched on install (postinstall -> scripts/fetch-grammar-wasm.mjs),
# hash-verified against the pin in grammar/grammar-source.mjs — not committed.
# grammar/README.md and grammar/grammar-source.mjs stay tracked.
# The glob also covers the `*.wasm.download` temp the fetch writes before rename.
packages/extension/grammar/*.wasm*

# Per-session agent worktrees — nested checkouts a blanket `git add` would
# otherwise stage as gitlinks.
.claude/worktrees/

# OpenModelica workspace build cache (created by the extension in any opened folder)
.modelica/

# Coverage reports (`pnpm test:coverage`), and the CRAP report derived from them.
coverage/
crap-report/
