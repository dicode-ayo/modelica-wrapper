{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/out/**/*.js"],
      "preLaunchTask": "extension: build",
      "sourceMaps": true,
      // `log.debug` is silent unless this is set, and the OMC call trace it
      // writes is the first thing anyone debugging the extension wants.
      "env": {
        "MODELICA_DEBUG": "1"
      }
    }
  ]
}
